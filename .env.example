# NoConBrain settings. Copy this file to .env, then set the one required value below.
#   cp .env.example .env
#   sed -i.bak "s/^NCB_PROXY_SECRET=.*/NCB_PROXY_SECRET=$(openssl rand -hex 32)/" .env && rm .env.bak
# Lines starting with # show the default. Remove the # to change a value.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Shared secret between the web and server containers (at least 16 characters).
# Generate one with: openssl rand -hex 32
NCB_PROXY_SECRET=

# ---------------------------------------------------------------------------
# Address and ports
# ---------------------------------------------------------------------------

# The address you type in the browser. Used for cross-site request checks and absolute links.
# Change it if you use another host name or port, for example http://brain.local:3000
#NCB_APP_URL=http://localhost:3000

# Host ports. The container listens on the same port it publishes.
# The browser needs both: the web port for the app and the archive port for archived pages.
#NCB_WEB_PORT=3000
#NCB_ARCHIVE_PORT=3002
# Where the browser reaches the archive listener when it is not the app host plus the port above (reverse proxy).
#NCB_ARCHIVE_PUBLIC_URL=
# Internal API port. It is never published; the web container reaches it over the private network.
#NCB_API_PORT=3001

# Which host address each published port binds to. Use 127.0.0.1 to keep a port off the network.
#NCB_WEB_BIND=0.0.0.0
#NCB_ARCHIVE_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# Sign-in and secrets
# ---------------------------------------------------------------------------

# password (default) needs a sign-in. trusted-lan also lets the listed networks browse and search read-only.
# trusted-lan needs NCB_TRUSTED_LAN_CIDRS and an existing administrator.
#NCB_AUTH_MODE=password
#NCB_TRUSTED_LAN_CIDRS=192.168.1.0/24

# Encrypts stored provider credentials. If empty, a key is generated into the data volume on first start.
#NCB_SECRET_KEY=

# Set to true when you serve the app over HTTPS (for example behind a reverse proxy).
#NCB_COOKIE_SECURE=false

# Set to true only when a reverse proxy you control sits in front of the web container,
# and list that proxy's address range.
#NCB_TRUST_PROXY=false
#NCB_TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where archived content is kept. A plain name (the default) is a Docker volume.
# A path, such as /mnt/ssd/noconbrain, is a bind mount: create it first and make it writable by UID 1000
#   sudo mkdir -p /mnt/ssd/noconbrain && sudo chown 1000:1000 /mnt/ssd/noconbrain
# An SSD is recommended on a Raspberry Pi.
#NCB_VOLUME_PATH=ncb-volume

# Folders inside the container that may be registered as storage. Comma separated.
#NCB_VOLUMES_ALLOWED_ROOTS=/volumes

# Downloads pause when free space on a storage volume falls below this many GB.
#NCB_MIN_FREE_DISK_GB=5

# The data directory inside the container (databases, secrets, temporary files). Lives in the ncb-data volume.
#NCB_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------

# pi-lite is the default on ARM64, standard elsewhere.
#NCB_RESOURCE_PROFILE=pi-lite
#NCB_MAX_FETCH_CONCURRENCY=2
#NCB_PER_HOST_CONCURRENCY=1
#NCB_EXTRACT_WORKERS=1
# Heap limit for each extraction worker, in MB.
#NCB_WORKER_MEMORY_MB=256

# Container limits applied by Compose.
#NCB_SERVER_MEMORY=768m
#NCB_SERVER_CPUS=2.0
#NCB_WEB_MEMORY=384m

# ---------------------------------------------------------------------------
# Crawling and online access
# ---------------------------------------------------------------------------

# Contact detail (an email address or a web page) added to the User-Agent that identifies this crawler.
#NCB_CONTACT=

# Optional address the server requests now and then to learn whether the internet is reachable.
# Empty (the default) means no probe: the state comes from the outcome of real requests.
#NCB_CONNECTIVITY_PROBE_URL=

# ---------------------------------------------------------------------------
# Logging and schedules
# ---------------------------------------------------------------------------

# fatal, error, warn, info, debug or trace
#NCB_LOG_LEVEL=info
# json or pretty
#NCB_LOG_FORMAT=json
#NCB_ACTIVITY_LOG_RETENTION_DAYS=30
# Seconds the server waits for running jobs to reach a safe point when it stops.
#NCB_SHUTDOWN_GRACE_SECONDS=25

# Backups and scheduled maintenance (docs/guides/backup-restore.md). Backups go to /data/backups; copy them off the machine.
#NCB_BACKUP_INTERVAL_HOURS=24      # 0 turns scheduled backups off
#NCB_BACKUP_KEEP=7
#NCB_BACKUP_INCLUDE_INDEX=false    # the index is rebuilt after a restore
#NCB_VERIFY_INTERVAL_HOURS=168     # full read-only verify; 0 = off
#NCB_JOB_RETENTION_DAYS=7          # finished jobs older than this are rolled into daily counters; 0 = keep

# The API answers only requests that carry the proxy secret (from web) or come from inside its own container.
#NCB_API_PROXY_ONLY=true
# Renderer proxy network (must match the render network's subnet in compose.yml).
#NCB_RENDER_SUBNET=172.31.250.0/24
# The proxy secret only counts from this network (the `backend` subnet in compose.yml), so the renderer and SearXNG, which hold a copy of it
# by default, cannot use it against the API. Change NCB_BACKEND_SUBNET only if it clashes with a network you already use.
#NCB_BACKEND_SUBNET=172.31.249.0/24
#NCB_TZ=UTC
#NCB_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# Image tag, and the Compose project name (it prefixes container, network and volume names).
#NCB_VERSION=latest
#COMPOSE_PROJECT_NAME=nocon-brain

# Optional services: searxng (self-hosted metasearch) and renderer (a headless browser for pages that are empty until their
# scripts run). To use the renderer set BOTH of these two lines; with neither, nothing is rendered and the renderer image is never built:
#COMPOSE_PROFILES=renderer
#NCB_RENDERER_URL=http://renderer:8080
# (several profiles: COMPOSE_PROFILES=searxng,renderer)
#COMPOSE_PROFILES=searxng
#NCB_SEARXNG_VERSION=latest
#NCB_SEARXNG_MEMORY=384m
# Key for SearXNG's own cookies. If empty, NCB_PROXY_SECRET is used.
#NCB_SEARXNG_SECRET=

# Renderer (profile `renderer`). It runs on an internal-only network and reaches the web only through the forward proxy
# that `server` runs (port NCB_RENDER_PROXY_PORT), with the same SSRF checks as the server's own downloads.
#NCB_RENDERER_MEMORY=1g
#NCB_RENDERER_CPUS=2.0
# Shared by server and renderer. If empty, NCB_PROXY_SECRET is used.
#NCB_RENDERER_SECRET=
#NCB_RENDER_PROXY_PORT=3128
# Pages rendered at once (a limits.renderConcurrency setting overrides it when the settings have one). Raise only with more memory.
#NCB_RENDER_CONCURRENCY=1
#NCB_RENDER_TIMEOUT_SECONDS=45
# Hosts that are never rendered, comma separated, exact or *.suffix.
#NCB_RENDER_NEVER_HOSTS=
#NCB_RENDERER_RESTART_AFTER_PAGES=50

# Document import: the largest file POST /api/archive/import accepts, in MiB.
#NCB_IMPORT_MAX_MB=50
